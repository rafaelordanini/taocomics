[Unit]
Description=Antigravity Worker (agy) - backup multimodal Gemini Pro para o TaoComics
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/antigravity-worker
Environment=WORKER_TOKEN=taocomics2024
Environment=AGY_MODEL=gemini-3.1-pro
ExecStart=%h/antigravity-worker-env/bin/uvicorn server:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
